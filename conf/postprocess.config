/*
 * Paramètres du post-traitement SpliceLauncher (filtre, récapitulatif, sashimi plots).
 * Ces valeurs dépendent de la série : les adapter ici, ou les surcharger sans modifier le dépôt
 *   - avec un fichier de paramètres : nextflow run main.nf -params-file mes_filtres.yaml
 *   - ou en ligne de commande     : --sl_min_non_statistical_reads 10
 */
params {
    skip_sl_postprocess             = false
    tools_container                 = null   // chemin absolu de l'image .sif (containers/tools/Dockerfile)

    /* Filtre (bin/sl_filter.py) */
    sl_min_non_statistical_reads    = 1      // lectures minimales de l'échantillon (jonctions non statistiques)
    sl_max_non_statistical_samples  = -1     // .filter : nb max d'échantillons portant la jonction (-1 = aucun)
    sl_max_statistical_samples      = -1     // .filter : nb max d'échantillons significatifs (-1 = aucun)
    sl_threshold_significance_level = 0      // .filter : 0 = tous, 1 = p<0.05, 2 = p<0.01, 3 = p<0.001

    /* Sashimi plots (bin/sl_sashimi.py) */
    skip_sashimi                    = false
    ggsashimi                       = 'ggsashimi.py'
    sashimi_extend_bp               = 50     // élargissement de la fenêtre (× 1 à 6 en cas d'échec)
    sashimi_min_reads               = -1     // -M de ggsashimi ; -1 = moitié des lectures de l'échantillon
    sashimi_nb_controls             = 4      // BAM témoins tirés au hasard
    sashimi_seed                    = 1      // graine du tirage (reproductible)
    sashimi_palette                 = null   // fichier de palette ggsashimi (-P)
}
