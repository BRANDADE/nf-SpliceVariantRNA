/*
 * Profil du cluster SLURM (NFS). Usage :
 *   nextflow run main.nf -profile slurm,singularity --samplesheet <fichier.tsv> -resume
 * Le profil singularity est requis pour IRFinder (conteneur params.irfinder_container).
 */
params {
    /* GÉNOME & ANNOTATIONS (GRCh37 / GENCODE v19) */
    genome_name    = 'Homo_sapiens.GRCh37.dna.primary_assembly.chr'
    fasta          = '/NFS/cluster-share/home/cmarco_user/data_rnaseq/references/Homo_sapiens.GRCh37.dna.primary_assembly.chr.fa'
    gff3           = '/NFS/cluster-share/home/cmarco_user/data_rnaseq/annotations/gencode.v19.annotation.gff3'
    mane           = '/NFS/cluster-share/home/cmarco_user/data_rnaseq/annotations/MANE.to.SpliceLauncher.txt'
    // GTF "CHR" (chromosomes de référence), même contenu que le GFF3 ci-dessus.
    gtf            = '/NFS/cluster-share/home/cmarco_user/data_rnaseq/annotations/gencode.v19.annotation.gtf'

    /* OUTILS */
    fastp          = '/NFS/cluster-share/env-share/tools/fastp/0.20.1/bin/fastp'
    fastqc         = '/NFS/cluster-share/env-share/tools/fastQC/v0.11.9/bin/fastqc'
    multiqc        = '/NFS/cluster-share/env-share/tools/multiQC/1.24.1/bin/multiqc'
    splicelauncher = '/NFS/cluster-share/home/cmarco_user/nf-SpliceVariantRNA/SpliceLauncher/SpliceLauncher.sh'
    star           = '/NFS/cluster-share/env-share/tools/STAR/2.7.11b/Linux_x86_64_static/STAR'
    samtools       = '/NFS/cluster-share/env-share/tools/samtools/1.22.1/bin/samtools'
    bedtools       = '/NFS/cluster-share/env-share/tools/bedtools/2.31.1/bin/bedtools'

    /* IRFINDER : module du cluster (v2.0.1, exécuté via Apptainer, voir env ci-dessous).
       Référence existante, construite par IRFinder BuildRef (chromosomes nommés '1', '2'…, index STAR
       inclus), utilisable en mode fastq :
         --irfinder_mode fastq --irfinder_ref /NFS/cluster-share/projects/rna/ROSA/IRFinder/IRFinder_ref
       En mode bam, les chromosomes de la référence doivent porter les mêmes noms que dans les BAM
       SpliceLauncher (le pipeline s'arrête sinon). */
    irfinder_module = 'IRFinder'
}

// Le module IRFinder tourne dans Apptainer : /NFS doit y être visible.
env {
    APPTAINER_BIND   = '/NFS'
    SINGULARITY_BIND = '/NFS'
}

executor {
    name      = 'slurm'
    queueSize = 50
}

process {
    executor = 'slurm'
    queue    = 'short'

    withName: 'FASTQC_.*' {
        cpus   = 2
        memory = { 2.GB * task.attempt }
    }
    withName: 'FASTP' {
        cpus   = 3
        memory = { 4.GB * task.attempt }
    }
    withName: 'SPLICELAUNCHER_INSTALL' {
        queue  = 'medium'
        cpus   = 12
        memory = { 40.GB * task.attempt }
        time   = '8h'
    }
    withName: 'SPLICELAUNCHER_ALIGN' {
        queue  = 'fat'
        cpus   = 6
        memory = { 40.GB * task.attempt }
        time   = '6h'
    }
    withName: 'SPLICELAUNCHER_(COUNT|ANALYSIS)' {
        queue  = 'medium'
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = '4h'
    }
    // Calcul de mappabilité : STAR charge l'index du génome humain (~30 Go de RAM) et
    // réaligne des lectures simulées sur tout le génome (plusieurs heures). Limite 'fat' : 7 j.
    withName: '.*:IRFINDER_BUILDREF' {
        queue  = 'fat'
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = '48h'
    }
    withName: '.*:IRFINDER_(QUANT_BAM|DIFF_.*|MERGE|OUTLIER_SUMMARY)' {
        queue  = 'medium'
    }
    // Mode fastq : un STAR par échantillon (~30 Go).
    withName: '.*:IRFINDER_QUANT_FASTQ' {
        queue  = 'fat'
        cpus   = 10
        memory = { 40.GB * task.attempt }
        time   = '24h'
    }
}
