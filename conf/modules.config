/*
 * Publication des résultats (remplace les rsync vers outdir faits dans les scripts).
 *
 * <outdir>/
 *   references/splicelauncher/<genome>/     références construites par le pipeline
 *   references/irfinder/<genome>/
 *   fastq_trimmed/<group>/
 *   qc/fastqc_raw/<group>/  qc/fastqc_trimmed/<group>/  qc/fastp/<group>/  qc/multiqc/
 *   splicelauncher/mapping/<group>/         BAM, BAI, SJ.out.tab, Log.final.out
 *   splicelauncher/<run_id>/{count_matrix,sample_counts,analysis_results}/
 *   irfinder/samples/<group>/<id>/          sorties IRFinder par échantillon
 *   irfinder/<run_id>/{matrices,outliers,conditions}/
 *   pipeline_info/
 */
process {
    withName: 'SPLICELAUNCHER_INSTALL' {
        publishDir = [
            path: { "${params.outdir}/references/splicelauncher" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'IRFINDER_BUILDREF' {
        publishDir = [
            path: { "${params.outdir}/references/irfinder" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'FASTQC_RAW' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_raw/${meta.group}" },
            mode: params.publish_dir_mode,
            pattern: '*_fastqc.{html,zip}',
        ]
    }
    withName: 'FASTQC_TRIMMED' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_trimmed/${meta.group}" },
            mode: params.publish_dir_mode,
            pattern: '*_fastqc.{html,zip}',
        ]
    }
    withName: 'FASTP' {
        publishDir = [
            [
                path: { "${params.outdir}/qc/fastp/${meta.group}" },
                mode: params.publish_dir_mode,
                pattern: '*.fastp.{json,html,log}',
            ],
            [
                path: { "${params.outdir}/fastq_trimmed/${meta.group}" },
                mode: params.publish_dir_mode,
                pattern: '*.trimmed.fastq.gz',
                enabled: params.save_trimmed,
            ],
        ]
    }
    withName: 'SPLICELAUNCHER_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/splicelauncher/mapping/${meta.group}" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'SPLICELAUNCHER_COUNT' {
        publishDir = [
            [
                path: { "${params.outdir}/splicelauncher/${run_id}/count_matrix" },
                mode: params.publish_dir_mode,
                pattern: '*.{txt,log}',
            ],
            [
                path: { "${params.outdir}/splicelauncher/${run_id}" },
                mode: params.publish_dir_mode,
                pattern: 'sample_counts/*',
            ],
        ]
    }
    withName: 'SPLICELAUNCHER_ANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/splicelauncher/${run_id}" },
            mode: params.publish_dir_mode,
            saveAs: { f -> f == "${run_id}_results" ? 'analysis_results' : f },
        ]
    }
    withName: '.*:IRFINDER_QUANT' {
        publishDir = [
            path: { "${params.outdir}/irfinder/samples/${meta.group}" },
            mode: params.publish_dir_mode,
            saveAs: { f -> f.endsWith('.txt') ? null : f },
        ]
    }
    withName: '.*:IRFINDER_MERGE' {
        publishDir = [
            path: { "${params.outdir}/irfinder/${run_id}/matrices" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: '.*:IRFINDER_DIFF_OUTLIER' {
        publishDir = [
            path: { "${params.outdir}/irfinder/${run_id}/outliers" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: '.*:IRFINDER_OUTLIER_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/irfinder/${run_id}" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: '.*:IRFINDER_DIFF_CONDITIONS' {
        publishDir = [
            path: { "${params.outdir}/irfinder/${run_id}" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/qc/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }
}
