/*
 * Ressources par défaut, par label. Les profils d'exécution (conf/slurm.config) peuvent les
 * surcharger avec withName, qui est prioritaire sur withLabel.
 * En cas de dépassement mémoire/temps (codes 104, 130-145), la tâche est relancée une fois
 * avec deux fois plus de mémoire et de temps.
 */
process {
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 4.h * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 12
        memory = { 40.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    // IRFinder BAM est mono-thread ; un BAM trié par coordonnées demande plus de mémoire.
    withLabel: 'process_irfinder_quant' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'irfinder' {
        container = params.irfinder_container
    }
    withLabel: 'tools' {
        container = params.tools_container
    }
}
