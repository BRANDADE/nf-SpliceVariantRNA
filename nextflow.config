manifest {
    name            = 'BRANDADE/nf-SpliceVariantRNA'
    description     = 'Détection de variants d\'épissage en RNA-seq : SpliceLauncher (jonctions) + IRFinder-S (rétention d\'intron)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
    version         = '0.2.0'
}

params {
    /* ENTRÉES / SORTIES */
    samplesheet              = null        // TSV : id, path_read1, path_read2, group_id [, technologie, condition]
    outdir                   = 'results'
    run_id                   = null        // défaut : nom du samplesheet sans extension
    publish_dir_mode         = 'copy'
    save_trimmed             = true

    /* GÉNOME & ANNOTATIONS */
    genome_name              = null
    fasta                    = null
    gff3                     = null        // annotation pour SpliceLauncher INSTALL
    mane                     = null        // table MANE au format SpliceLauncher
    gtf                      = null        // annotation pour IRFinder (GTF avec gene_type/transcript_type)

    /* RÉFÉRENCES DÉJÀ CONSTRUITES (sinon construites puis publiées dans <outdir>/references) */
    splicelauncher_ref       = null
    irfinder_ref             = null

    /* FASTP */
    min_length               = 100
    qualified_quality        = 20          // --qualified_quality_phred (seuil PAR BASE)
    average_qual             = 0           // --average_qual (qualité MOYENNE du read ; 0 = désactivé)
    mean_quality             = null        // obsolète, remplacé par qualified_quality

    /* SPLICELAUNCHER */
    min_cov                  = 5
    threshold                = 1
    graphics                 = true
    txt_out                  = false
    bed_out                  = false

    /* IRFINDER */
    skip_irfinder            = false
    irfinder_container       = 'cloxd/irfinder:2.0.1'  // ou chemin absolu d'une image .sif
    irfinder_mapability      = null        // BED précalculé (-M) ; sinon calculé (plusieurs heures)
    irfinder_mapability_len  = 100         // longueur des lectures simulées pour la mappabilité (-n)
    irfinder_blacklist       = null        // -b
    irfinder_roi             = null        // -R
    irfinder_star            = null        // binaire STAR pour la mappabilité (-S) ; défaut : celui du conteneur
    irfinder_ir_file         = 'nondir'    // 'nondir' (toujours produit) ou 'dir' (librairies orientées)
    irfinder_cnn_min_ir      = 0.05        // IRratio minimal pour la validation CNN (IRFinder BAM -R)
    irfinder_outlier         = true        // chaque échantillon contre tous les autres
    irfinder_outlier_min_samples = 4       // soit au moins 3 échantillons dans le groupe 'others'
    irfinder_min_ir          = 0.05        // IRFinder Diff -ir
    irfinder_warning_level   = 2           // IRFinder Diff -wl
    irfinder_padj            = 0.05        // seuil du tableau récapitulatif des outliers

    /* QC */
    skip_multiqc             = false

    /* OUTILS (commandes dans le PATH par défaut ; chemins absolus dans conf/slurm.config) */
    fastp                    = 'fastp'
    fastqc                   = 'fastqc'
    multiqc                  = 'multiqc'
    splicelauncher           = null        // chemin de SpliceLauncher.sh (obligatoire)
    star                     = 'STAR'
    samtools                 = 'samtools'
    bedtools                 = 'bedtools'
    rscript                  = null        // défaut : valeur du config.cfg de SpliceLauncher
    perl                     = null        // idem
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
